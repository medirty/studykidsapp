# Salin ke backend/.env (di-ignore Git, jangan pernah di-commit).
# Isi nilai asli hanya di file .env lokal/server, bukan di sini.

# Lingkungan: local | testing | staging | production (D-003)
APP_ENV=local

# Path PHP 8.4 lokal (bukan PHP XAMPP). Di server/CI boleh dikosongkan.
PHP_BIN=C:\php-8.4\php.exe

# Database MariaDB 11.8 (sama dengan Hostinger). Pakai user khusus, bukan root.
# DB_CLIENT_BIN (opsional): path penuh mariadb.exe jika bukan di C:\Program Files\MariaDB 11.8\bin.
DB_CLIENT_BIN=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=studykids_dev
DB_TEST_NAME=studykids_test
DB_USER=studykids
DB_PASS=
