{
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./frontend/node_modules/**)",
      "Read(./backend/vendor/**)",
      "Read(./**/dist/**)",
      "Read(./**/package-lock.json)",
      "Read(./**/composer.lock)",
      "Read(./.env)",
      "Read(./backend/.env)"
    ]
  },
  "model": "opusplan",
  "enabledMcpjsonServers": [
    "playwright",
    "context7",
    "chrome-devtools"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/doctor.mjs --quiet || exit 0"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  }
}
