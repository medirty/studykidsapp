# Salin ke .env (di-ignore Git). Hanya variabel build frontend (Vite).
# JANGAN isi secret di sini: semua nilai di file ini publik.

# Mode data: "local" (IndexedDB, tanpa backend; dipakai GitHub Pages) atau "api"
VITE_API_MODE=local

# Base path build: "/" untuk lokal & produksi, "/studykidsapp/" untuk GitHub Pages
VITE_BASE=/
