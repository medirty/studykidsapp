{
  "name": "@studykids/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "size": "node ../scripts/check-bundle-size.mjs dist",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run size"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.4.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.0",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "svelte-spa-router": "^5.1.1"
  }
}
