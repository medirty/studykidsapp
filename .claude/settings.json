{
  "model": "opusplan",
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./frontend/node_modules/**)",
      "Read(./backend/vendor/**)",
      "Read(./**/dist/**)",
      "Read(./**/package-lock.json)",
      "Read(./**/composer.lock)",
      "Read(./.env)",
      "Read(./backend/.env)"
    ]
  }
}
